{
  "name": "internship-hunter",
  "version": "0.1.0",
  "description": "Find mechanical engineering internships, tailor your resume, and pre-fill applications.",
  "main": "out/main/index.js",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test:sources": "node --no-warnings --import ./scripts/resolve-ts.mjs scripts/test-sources.ts",
    "package": "electron-vite build && electron-builder --mac dir"
  },
  "build": {
    "appId": "local.jarvis-internships",
    "productName": "J.A.R.V.I.S",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "mac": {
      "target": "dir",
      "identity": null
    }
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^45.3.2",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/source-serif-4": "^5.3.1",
    "diff": "^9.0.0",
    "pdf-parse": "^2.4.5",
    "playwright-core": "^1.65.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  }
}
